# Ambiente de Transbank: integration o production.
TRANSBANK_ENVIRONMENT=integration

# Configurar las credenciales del ambiente fuera del repositorio.
# En producción, el código de comercio es 597053106182.
# TRANSBANK_COMMERCE_CODE=
# TRANSBANK_API_KEY=

# URL pública usada como retorno desde Webpay.
PUBLIC_SITE_URL=https://www.congeladosromasil.cl

# Ya utilizada por el envío de pedidos y por el aviso interno de pago autorizado.
# RESEND_API_KEY=

# Integración servidor a servidor con la intranet. El secreto debe ser el mismo
# valor configurado como WEB_ORDER_SECRET en romasil-ventas.
INTRANET_API_URL=https://romasil-ventas.vercel.app
INTRANET_WEBHOOK_SECRET=genere-un-secreto-aleatorio-de-al-menos-32-caracteres
